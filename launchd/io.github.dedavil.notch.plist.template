<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by install.sh: __APP_BIN__ and __LOG_DIR__ are substituted. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.dedavil.notch</string>
    <key>ProgramArguments</key>
    <array>
        <string>__APP_BIN__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/notch.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/notch.err.log</string>
</dict>
</plist>
